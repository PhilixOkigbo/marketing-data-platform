ter_than_impressions.None.generic\", \"detected_at\": \"2026-10-20T20:21:22+00:00\", \"database_name\": \"development\", \"schema_name\": \"dbt_chinedu_marts\", \"table_name\": \"fct_marketing_spend\", \"column_name\": null, \"test_type\": \"dbt_test\", \"test_sub_type\": \"generic\", \"test_results_description\": null, \"test_description\": null, \"original_path\": \"tests\\\\assert_clicks_not_greater_than_impressions.sql\", \"package_name\": \"marketing_dbt\", \"owners\": \"[]\", \"model_owner\": \"[]\", \"tags\": \"[]\", \"test_tags\": \"[]\", \"model_tags\": \"[]\", \"meta\": \"{}\", \"model_meta\": \"{}\", \"test_results_query\": \"-- A click requires an impression, so clicks > impressions signals bad source data.\\nselect *\\nfrom `development`.`dbt_chinedu_marts`.`fct_marketing_spend`\\nwhere clicks > impressions\", \"other\": null, \"test_name\": \"assert_clicks_not_greater_than_impressions\", \"test_params\": \"{}\", \"severity\": \"ERROR\", \"status\": \"pass\", \"execution_time\": 4.111133098602295, \"days_diff\": 0, \"invocations_rank_index\": 1, \"failures\": 0, \"result_rows\": null, \"sample_data\": null}, {\"id\": \"c80090b2-98cf-4aef-aeff-735de1153828.test.marketing_dbt.assert_metrics_in_fact_match_campaign_mart\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"test_execution_id\": \"c80090b2-98cf-4aef-aeff-735de1153828.test.marketing_dbt.assert_metrics_in_fact_match_campaign_mart\", \"model_unique_id\": null, \"test_unique_id\": \"test.marketing_dbt.assert_metrics_in_fact_match_campaign_mart\", \"elementary_unique_id\": \"test.marketing_dbt.assert_metrics_in_fact_match_campaign_mart.None.generic\", \"detected_at\": \"2026-10-20T20:21:54+00:00\", \"database_name\": \"development\", \"schema_name\": \"dbt_chinedu\", \"table_name\": null, \"column_name\": null, \"test_type\": \"dbt_test\", \"test_sub_type\": \"generic\", \"test_results_description\": null, \"test_description\": null, \"original_path\": \"tests\\\\assert_metrics_in_fact_match_campaign_mart.sql\", \"package_name\": \"marketing_dbt\", \"owners\": \"[]\", \"model_owner\": null, \"tags\": \"[]\", \"test_tags\": \"[]\", \"model_tags\": null, \"meta\": \"{}\", \"model_meta\": null, \"test_results_query\": \"-- The campaign mart is an aggregate of the fact table; totals must agree.\\nselect 1\\nfrom (select sum(spend_eur) as s, sum(clicks) as c, sum(impressions) as i from `development`.`dbt_chinedu_marts`.`fct_marketing_spend`) f\\ncross join (select sum(spend_eur) as s, sum(clicks) as c, sum(impressions) as i from `development`.`dbt_chinedu_marts`.`fct_campaign_performance_daily`) m\\nwhere abs(f.s - m.s) > 0.01 or f.c != m.c or f.i != m.i\", \"other\": null, \"test_name\": \"assert_metrics_in_fact_match_campaign_mart\", \"test_params\": \"{}\", \"severity\": \"ERROR\", \"status\": \"pass\", \"execution_time\": 4.016530513763428, \"days_diff\": 0, \"invocations_rank_index\": 1, \"failures\": 0, \"result_rows\": null, \"sample_data\": null}, {\"id\": \"c80090b2-98cf-4aef-aeff-735de1153828.test.marketing_dbt.assert_spend_reconciles_to_source\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"test_execution_id\": \"c80090b2-98cf-4aef-aeff-735de1153828.test.marketing_dbt.assert_spend_reconciles_to_source\", \"model_unique_id\": null, \"test_unique_id\": \"test.marketing_dbt.assert_spend_reconciles_to_source\", \"elementary_unique_id\": \"test.marketing_dbt.assert_spend_reconciles_to_source.None.generic\", \"detected_at\": \"2026-10-20T20:21:22+00:00\", \"database_name\": \"development\", \"schema_name\": \"dbt_chinedu\", \"table_name\": null, \"column_name\": null, \"test_type\": \"dbt_test\", \"test_sub_type\": \"generic\", \"test_results_description\": null, \"test_description\": null, \"original_path\": \"tests\\\\assert_spend_reconciles_to_source.sql\", \"package_name\": \"marketing_dbt\", \"owners\": \"[]\", \"model_owner\": null, \"tags\": \"[]\", \"test_tags\": \"[]\", \"model_tags\": null, \"meta\": \"{}\", \"model_meta\": null, \"test_results_query\": \"-- Total spend per platform in the final model must equal total spend in the raw data.\\n-- Catches rows lost or duplicated by joins, deduplication or the incremental logic.\\nwith model as (\\n    select platform, sum(spend) as spend\\n    from `development`.`dbt_chinedu_marts`.`fct_marketing_spend`\\n    group by platform\\n),\\n\\nsource as (\\n    select 'facebook' as platform, sum(try_cast(ad_spend as decimal(18, 6))) as spend\\n    from `bronze`.`facebook_ads`.`ads_stats`\\n    union all\\n    select 'snapchat' as platform, sum(try_cast(ad_spend as decimal(18, 6))) as spend\\n    from `bronze`.`snapchat_ads`.`snapchat_ads_stats`\\n)\\n\\nselect source.platform, source.spend as source_spend, model.spend as model_spend\\nfrom source\\nleft join model on source.platform = model.platform\\nwhere abs(coalesce(model.spend, 0) - coalesce(source.spend, 0)) > 0.01\", \"other\": null, \"test_name\": \"assert_spend_reconciles_to_source\", \"test_params\": \"{}\", \"severity\": \"ERROR\", \"status\": \"pass\", \"execution_time\": 4.994911193847656, \"days_diff\": 0, \"invocations_rank_index\": 1, \"failures\": 0, \"result_rows\": null, \"sample_data\": null}, {\"id\": \"c80090b2-98cf-4aef-aeff-735de1153828.test.marketing_dbt.dbt_utils_accepted_range_fct_campaign_performance_daily_ctr__1__0.90b7d692f7\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"test_execution_id\": \"c80090b2-98cf-4aef-aeff-735de1153828.test.marketing_dbt.dbt_utils_accepted_range_fct_campaign_performance_daily_ctr__1__0.90b7d692f7\", \"model_unique_id\": \"model.marketing_dbt.fct_campaign_performance_daily\", \"test_unique_id\": \"test.marketing_dbt.dbt_utils_accepted_range_fct_campaign_performance_daily_ctr__1__0.90b7d692f7\", \"elementary_unique_id\": \"test.marketing_dbt.dbt_utils_accepted_range_fct_campaign_performance_daily_ctr__1__0.90b7d692f7.ctr.generic\", \"detected_at\": \"2026-10-20T20:21:54+00:00\", \"database_name\": \"development\", 