{"data": {"msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.marketing_dbt.fct_campaign_performance_daily\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"fct_campaign_performance_daily\", \"schema\": \"dbt_chinedu_marts\", \"status\": \"success\", \"execution_time\": 6.2, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"-- Campaign performance per platform per day, with CTR / CPC / CPM.\\n-- Grain: one row per platform per campaign per day.\\n--\\n-- Ratios are calculated AFTER summing, so they are correct at this grain.\\n-- Never average these ratios across rows: re-aggregate the base metrics instead\\n-- (e.g. CTR for a month = sum(clicks) / sum(impressions)).\\n-- Table: small, pre-aggregated, and the main entry point for BI and AI agents.\\n\\nwith campaign_daily as (\\n    select\\n        platform,\\n        date_day,\\n        campaign_id,\\n        max(campaign_name)      as campaign_name,\\n        currency_code,\\n        sum(spend)              as spend,\\n        sum(spend_eur)          as spend_eur,\\n        sum(impressions)        as impressions,\\n        sum(clicks)             as clicks\\n    from `development`.`dbt_chinedu_marts`.`fct_marketing_spend`\\n    group by platform, date_day, campaign_id, currency_code\\n)\\n\\nselect\\n    md5(cast(concat(coalesce(cast(platform as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(campaign_id as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(date_day as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(currency_code as string), '_dbt_utils_surrogate_key_null_')) as string)) as campaign_performance_id,\\n    platform,\\n    date_day,\\n    campaign_id,\\n    campaign_name,\\n    currency_code,\\n    spend,\\n    spend_eur,\\n    impressions,\\n    clicks,\\n    -- nullif -> null instead of divide-by-zero when there is no denominator\\n    cast(clicks / nullif(impressions, 0) as decimal(18, 6))           as ctr,\\n    cast(spend_eur / nullif(clicks, 0) as decimal(18, 6))             as cpc_eur,\\n    cast(spend_eur / nullif(impressions, 0) * 1000 as decimal(18, 6)) as cpm_eur\\nfrom campaign_daily\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.fct_marketing_spend\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"fct_marketing_spend\", \"schema\": \"dbt_chinedu_marts\", \"status\": \"success\", \"execution_time\": 9.9, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n-- Unified marketing fact table.\\n-- Grain: one row per platform per ad per day.\\n--\\n-- Incremental: this is the largest table and ad platforms only add new days (or\\n-- restate the last few), so each run only reprocesses recent data per platform and\\n-- MERGEs it on marketing_spend_id. A 3-day lookback picks up late restatements.\\n-- The watermark is per platform, because the platforms load on different schedules.\\n\\nwith source as (\\n    select * from `development`.`dbt_chinedu_intermediate`.`int_marketing_ads`\\n)\\n\\n\\n\\nselect\\n    source.marketing_spend_id,\\n    source.date_day,\\n    source.platform,\\n    source.account_id,\\n    source.account_name,\\n    source.campaign_id,\\n    source.campaign_name,\\n    source.ad_group_id,\\n    source.ad_group_name,\\n    source.ad_id,\\n    source.ad_name,\\n    source.currency_code,\\n    source.spend,\\n    source.spend_eur,\\n    source.impressions,\\n    source.clicks,\\n    current_timestamp() as dbt_loaded_at\\nfrom source\\n\\n\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.int_marketing_ads\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"int_marketing_ads\", \"schema\": \"dbt_chinedu_intermediate\", \"status\": \"success\", \"execution_time\": 5, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Facebook and Snapchat in one common structure, with spend also converted to EUR.\\n-- Grain: one row per platform per ad per day.\\n-- View: cheap to keep, read only by the marts.\\n\\nwith  __dbt__cte__int_facebook_ads__daily as (\\n\\n-- Facebook daily stats enriched with ad, ad group, campaign and account attributes,\\n-- renamed to the shared marketing vocabulary.\\n-- Grain: one row per ad per day. Ephemeral: only used by int_marketing_ads.\\n\\nselect\\n    'facebook'              as platform,\\n    s.date_day,\\n    s.account_id,\\n    acc.account_name,\\n    a.campaign_id,\\n    c.campaign_name,\\n    a.ad_group_id,\\n    g.ad_group_name,\\n    s.ad_id,\\n    a.ad_name,\\n    acc.currency_code,\\n    s.spend,\\n    s.impressions,\\n    s.clicks\\nfrom `development`.`dbt_chinedu_staging`.`stg_facebook_ads__ad_stats` as s\\nleft join `development`.`dbt_chinedu_staging`.`stg_facebook_ads__ads` as a\\n    on s.ad_id = a.ad_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_facebook_ads__ad_groups` as g\\n    on a.ad_group_id = g.ad_group_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_facebook_ads__campaigns` as c\\n    on a.campaign_id = c.campaign_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_facebook_ads__accounts` as acc\\n    on s.account_id = acc.account_id\\n),  __dbt__cte__int_snapchat_ads__daily as (\\n\\n-- Snapchat daily stats rolled up from ad x day x country to ad x day (to match Facebook),\\n-- enriched with ad, ad group and campaign attributes.\\n-- Grain: one row per ad per day. Ephemeral: only used by int_marketing_ads.\\n\\nwith daily as (\\n    select\\n        ad_id,\\n        date_day,\\n        currency_code,\\n        sum(spend)          as spend,\\n        sum(impressions)    as impressions,\\n        sum(clicks)         as clicks\\n    from `development`.`dbt_chinedu_staging`.`stg_snapchat_ads__ad_stats`\\n    group by ad_id, date_day, currency_code\\n)\\n\\nselect\\n    'snapchat'              as platform,\\n    d.date_day,\\n    c.account_id,\\n    cast(null as string)    as account_name,   -- Snapchat export has no account names\\n    g.campaign_id,\\n    c.campaign_name,\\n    a.ad_group_id,\\n    g.ad_group_name,\\n    d.ad_id,\\n    a.ad_name,\\n    d.currency_code,\\n    d.spend,\\n    d.impressions,\\n    d.clicks\\nfrom daily as d\\nleft join `development`.`dbt_chinedu_staging`.`stg_snapchat_ads__ads` as a\\n    on d.ad_id = a.ad_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_snapchat_ads__ad_groups` as g\\n    on a.ad_group_id = g.ad_group_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_snapchat_ads__campaigns` as c\\n    on g.campaign_id = c.campaign_id\\n), unioned as (\\n    select * from __dbt__cte__int_facebook_ads__daily\\n    union all\\n    select * from __dbt__cte__int_snapchat_ads__daily\\n)\\n\\nselect\\n    md5(cast(concat(coalesce(cast(u.platform as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(u.ad_id as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(u.date_day as string), '_dbt_utils_surrogate_key_null_')) as string)) as marketing_spend_id,\\n    u.platform,\\n    u.date_day,\\n    u.account_id,\\n    u.account_name,\\n    u.campaign_id,\\n    u.campaign_name,\\n    u.ad_group_id,\\n    u.ad_group_name,\\n    u.ad_id,\\n    u.ad_name,\\n    u.currency_code,\\n    u.spend,\\n    cast(u.spend * fx.rate_to_eur as decimal(18, 6)) as spend_eur,\\n    u.impressions,\\n    u.clicks\\nfrom unioned as u\\nleft join `development`.`dbt_chinedu_reference`.`currency_rates_to_eur` as fx\\n    on u.currency_code = fx.currency_code\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_facebook_ads__accounts\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_facebook_ads__accounts\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per ad account. Currency lives here, not on the stats table.\\nselect\\n    cast(account_id as string)              as account_id,\\n    cast(account_name as string)            as account_name,\\n    upper(ad_currency_code)                 as currency_code,\\n    cast(account_created_at as timestamp)   as account_created_at,\\n    cast(account_updated_at as timestamp)   as account_updated_at\\nfrom `bronze`.`facebook_ads`.`new_acccount_de_randomized`\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_facebook_ads__ad_groups\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_facebook_ads__ad_groups\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per ad group (ad set).\\nselect\\n    cast(ad_group_id as string)             as ad_group_id,\\n    cast(ad_group_name as string)           as ad_group_name,\\n    cast(ad_group_updated_at as timestamp)  as ad_group_updated_at\\nfrom `bronze`.`facebook_ads`.`new_adgroup_de_randomized`\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_facebook_ads__ad_stats\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_facebook_ads__ad_stats\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per ad per day.\\n-- Raw columns are strings (bronze keeps the file as-is); types are set here.\\nwith source as (\\n    select * from `bronze`.`facebook_ads`.`ads_stats`\\n)\\n\\nselect\\n    cast(ad_id as string)                                   as ad_id,\\n    cast(account_id as string)                              as account_id,\\n    cast(ad_date as date)                                   as date_day,\\n    coalesce(try_cast(ad_spend as decimal(18, 6)), 0)       as spend,\\n    -- Missing impressions/clicks in the export mean \\\"none recorded\\\" -> 0\\n    coalesce(try_cast(ad_impressions as bigint), 0)         as impressions,\\n    coalesce(try_cast(ad_clicks as bigint), 0)              as clicks\\nfrom source\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_facebook_ads__ads\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_facebook_ads__ads\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per ad.\\nselect\\n    cast(ad_id as string)                   as ad_id,\\n    cast(ad_name as string)                 as ad_name,\\n    cast(ad_group_id as string)             as ad_group_id,\\n    cast(campaign_id as string)             as campaign_id,\\n    cast(account_id as string)              as account_id,\\n    lower(ad_status)                        as ad_status,\\n    cast(ad_updated_at as timestamp)        as ad_updated_at\\nfrom `bronze`.`facebook_ads`.`new_ads_de_randomized`\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_facebook_ads__campaigns\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_facebook_ads__campaigns\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per campaign.\\nselect\\n    cast(campaign_id as string)             as campaign_id,\\n    cast(campaign_name as string)           as campaign_name,\\n    cast(campaign_updated_at as timestamp)  as campaign_updated_at\\nfrom `bronze`.`facebook_ads`.`new_campaign_de_randomized`\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_snapchat_ads__ad_groups\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_snapchat_ads__ad_groups\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per ad group.\\n-- The raw table is a history table (an ad group can appear more than once);\\n-- keep only the most recent version.\\nselect\\n    cast(ad_group_id as string)                 as ad_group_id,\\n    cast(ad_group_name as string)               as ad_group_name,\\n    cast(campaign_id as string)                 as campaign_id,\\n    cast(ad_group_updated_at as timestamp)      as ad_group_updated_at\\nfrom `bronze`.`snapchat_ads`.`snapchat_ads_adgroup_history_new_ad_group_names`\\nqualify row_number() over (\\n    partition by ad_group_id\\n    order by cast(ad_group_updated_at as timestamp) desc\\n) = 1\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_snapchat_ads__ad_stats\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_snapchat_ads__ad_stats\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.1, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per ad per day per country (Snapchat reports by country).\\n-- Rolled up to ad x day in int_snapchat_ads__daily.\\n-- Spend is already in normal currency units (not micro-currency).\\nwith source as (\\n    select * from `bronze`.`snapchat_ads`.`snapchat_ads_stats`\\n)\\n\\nselect\\n    cast(ad_detail_id as string)                            as ad_id,\\n    cast(ad_date as date)                                   as date_day,\\n    lower(ad_country)                                       as country_code,\\n    upper(ad_currency_code)                                 as currency_code,\\n    coalesce(try_cast(ad_spend as decimal(18, 6)), 0)       as spend,\\n    coalesce(try_cast(ad_impressions as bigint), 0)         as impressions,\\n    coalesce(try_cast(ad_clicks as bigint), 0)              as clicks\\nfrom source\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_snapchat_ads__ads\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_snapchat_ads__ads\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per ad.\\nselect\\n    cast(ad_id as string)                       as ad_id,\\n    cast(ad_name as string)                     as ad_name,\\n    cast(ad_group_id as string)                 as ad_group_id,\\n    cast(ad_detail_updated_at as timestamp)     as ad_updated_at\\nfrom `bronze`.`snapchat_ads`.`snapchat_ads_ad_history_new_ad_names`\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_snapchat_ads__campaigns\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_snapchat_ads__campaigns\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per campaign. Snapchat has no account table; account_id comes from here.\\nselect\\n    cast(campaign_id as string)     as campaign_id,\\n    cast(campaign_name as string)   as campaign_name,\\n    cast(account_id as string)      as account_id\\nfrom `bronze`.`snapchat_ads`.`snapchat_ads_campaign_history_new_campaign_names`\", \"generated_at\": \"2026-10-20 20:22:32\"}]--ELEMENTARY-MACRO-OUTPUT-END--"}, "info": {"category": "", "code": "I062", "extra": {}, "invocation_id": "15854e91-3dc5-496b-bf56-9a3318318374", "level": "info", "msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.marketing_dbt.fct_campaign_performance_daily\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"fct_campaign_performance_daily\", \"schema\": \"dbt_chinedu_marts\", \"status\": \"success\", \"execution_time\": 6.2, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"-- Campaign performance per platform per day, with CTR / CPC / CPM.\\n-- Grain: one row per platform per campaign per day.\\n--\\n-- Ratios are calculated AFTER summing, so they are correct at this grain.\\n-- Never average these ratios across rows: re-aggregate the base metrics instead\\n-- (e.g. CTR for a month = sum(clicks) / sum(impressions)).\\n-- Table: small, pre-aggregated, and the main entry point for BI and AI agents.\\n\\nwith campaign_daily as (\\n    select\\n        platform,\\n        date_day,\\n        campaign_id,\\n        max(campaign_name)      as campaign_name,\\n        currency_code,\\n        sum(spend)              as spend,\\n        sum(spend_eur)          as spend_eur,\\n        sum(impressions)        as impressions,\\n        sum(clicks)             as clicks\\n    from `development`.`dbt_chinedu_marts`.`fct_marketing_spend`\\n    group by platform, date_day, campaign_id, currency_code\\n)\\n\\nselect\\n    md5(cast(concat(coalesce(cast(platform as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(campaign_id as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(date_day as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(currency_code as string), '_dbt_utils_surrogate_key_null_')) as string)) as campaign_performance_id,\\n    platform,\\n    date_day,\\n    campaign_id,\\n    campaign_name,\\n    currency_code,\\n    spend,\\n    spend_eur,\\n    impressions,\\n    clicks,\\n    -- nullif -> null instead of divide-by-zero when there is no denominator\\n    cast(clicks / nullif(impressions, 0) as decimal(18, 6))           as ctr,\\n    cast(spend_eur / nullif(clicks, 0) as decimal(18, 6))             as cpc_eur,\\n    cast(spend_eur / nullif(impressions, 0) * 1000 as decimal(18, 6)) as cpm_eur\\nfrom campaign_daily\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.fct_marketing_spend\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"fct_marketing_spend\", \"schema\": \"dbt_chinedu_marts\", \"status\": \"success\", \"execution_time\": 9.9, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n-- Unified marketing fact table.\\n-- Grain: one row per platform per ad per day.\\n--\\n-- Incremental: this is the largest table and ad platforms only add new days (or\\n-- restate the last few), so each run only reprocesses recent data per platform and\\n-- MERGEs it on marketing_spend_id. A 3-day lookback picks up late restatements.\\n-- The watermark is per platform, because the platforms load on different schedules.\\n\\nwith source as (\\n    select * from `development`.`dbt_chinedu_intermediate`.`int_marketing_ads`\\n)\\n\\n\\n\\nselect\\n    source.marketing_spend_id,\\n    source.date_day,\\n    source.platform,\\n    source.account_id,\\n    source.account_name,\\n    source.campaign_id,\\n    source.campaign_name,\\n    source.ad_group_id,\\n    source.ad_group_name,\\n    source.ad_id,\\n    source.ad_name,\\n    source.currency_code,\\n    source.spend,\\n    source.spend_eur,\\n    source.impressions,\\n    source.clicks,\\n    current_timestamp() as dbt_loaded_at\\nfrom source\\n\\n\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.int_marketing_ads\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"int_marketing_ads\", \"schema\": \"dbt_chinedu_intermediate\", \"status\": \"success\", \"execution_time\": 5, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Facebook and Snapchat in one common structure, with spend also converted to EUR.\\n-- Grain: one row per platform per ad per day.\\n-- View: cheap to keep, read only by the marts.\\n\\nwith  __dbt__cte__int_facebook_ads__daily as (\\n\\n-- Facebook daily stats enriched with ad, ad group, campaign and account attributes,\\n-- renamed to the shared marketing vocabulary.\\n-- Grain: one row per ad per day. Ephemeral: only used by int_marketing_ads.\\n\\nselect\\n    'facebook'              as platform,\\n    s.date_day,\\n    s.account_id,\\n    acc.account_name,\\n    a.campaign_id,\\n    c.campaign_name,\\n    a.ad_group_id,\\n    g.ad_group_name,\\n    s.ad_id,\\n    a.ad_name,\\n    acc.currency_code,\\n    s.spend,\\n    s.impressions,\\n    s.clicks\\nfrom `development`.`dbt_chinedu_staging`.`stg_facebook_ads__ad_stats` as s\\nleft join `development`.`dbt_chinedu_staging`.`stg_facebook_ads__ads` as a\\n    on s.ad_id = a.ad_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_facebook_ads__ad_groups` as g\\n    on a.ad_group_id = g.ad_group_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_facebook_ads__campaigns` as c\\n    on a.campaign_id = c.campaign_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_facebook_ads__accounts` as acc\\n    on s.account_id = acc.account_id\\n),  __dbt__cte__int_snapchat_ads__daily as (\\n\\n-- Snapchat daily stats rolled up from ad x day x country to ad x day (to match Facebook),\\n-- enriched with ad, ad group and campaign attributes.\\n-- Grain: one row per ad per day. Ephemeral: only used by int_marketing_ads.\\n\\nwith daily as (\\n    select\\n        ad_id,\\n        date_day,\\n        currency_code,\\n        sum(spend)          as spend,\\n        sum(impressions)    as impressions,\\n        sum(clicks)         as clicks\\n    from `development`.`dbt_chinedu_staging`.`stg_snapchat_ads__ad_stats`\\n    group by ad_id, date_day, currency_code\\n)\\n\\nselect\\n    'snapchat'              as platform,\\n    d.date_day,\\n    c.account_id,\\n    cast(null as string)    as account_name,   -- Snapchat export has no account names\\n    g.campaign_id,\\n    c.campaign_name,\\n    a.ad_group_id,\\n    g.ad_group_name,\\n    d.ad_id,\\n    a.ad_name,\\n    d.currency_code,\\n    d.spend,\\n    d.impressions,\\n    d.clicks\\nfrom daily as d\\nleft join `development`.`dbt_chinedu_staging`.`stg_snapchat_ads__ads` as a\\n    on d.ad_id = a.ad_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_snapchat_ads__ad_groups` as g\\n    on a.ad_group_id = g.ad_group_id\\nleft join `development`.`dbt_chinedu_staging`.`stg_snapchat_ads__campaigns` as c\\n    on g.campaign_id = c.campaign_id\\n), unioned as (\\n    select * from __dbt__cte__int_facebook_ads__daily\\n    union all\\n    select * from __dbt__cte__int_snapchat_ads__daily\\n)\\n\\nselect\\n    md5(cast(concat(coalesce(cast(u.platform as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(u.ad_id as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(u.date_day as string), '_dbt_utils_surrogate_key_null_')) as string)) as marketing_spend_id,\\n    u.platform,\\n    u.date_day,\\n    u.account_id,\\n    u.account_name,\\n    u.campaign_id,\\n    u.campaign_name,\\n    u.ad_group_id,\\n    u.ad_group_name,\\n    u.ad_id,\\n    u.ad_name,\\n    u.currency_code,\\n    u.spend,\\n    cast(u.spend * fx.rate_to_eur as decimal(18, 6)) as spend_eur,\\n    u.impressions,\\n    u.clicks\\nfrom unioned as u\\nleft join `development`.`dbt_chinedu_reference`.`currency_rates_to_eur` as fx\\n    on u.currency_code = fx.currency_code\", \"generated_at\": \"2026-10-20 20:22:32\"}, {\"unique_id\": \"model.marketing_dbt.stg_facebook_ads__accounts\", \"invocation_id\": \"c80090b2-98cf-4aef-aeff-735de1153828\", \"name\": \"stg_facebook_ads__accounts\", \"schema\": \"dbt_chinedu_staging\", \"status\": \"success\", \"execution_time\": 3.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Grain: one row per ad account. Currency lives here, not on the stats table.\\nselect\\n    cast(account_id as string)              as account_id,\\n    cast(account_name as string)            as account_name,\\n    upper(ad_currency_code)                 as currency_code,\\n    cast(account_crea